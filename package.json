{
  "name": "@poli-page/nextjs",
  "version": "0.11.0",
  "description": "Official Next.js integration for the Poli Page PDF rendering API",
  "license": "MIT",
  "author": "Poli Page",
  "keywords": ["nextjs", "next", "app-router", "edge", "poli-page", "pdf", "pdf-generation", "html-to-pdf", "templates", "sdk"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "engines": { "node": ">=20.18.0" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:pack": "attw --pack . --profile node16 && publint --strict",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --project integration-node --project integration-edge",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "next": ">=13.4.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "dependencies": {
    "@poli-page/sdk": "^0.11.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@edge-runtime/vm": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "next": "^15.0.0",
    "publint": "^0.3.25",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.0.0"
  },
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/poli-page/nextjs.git" },
  "homepage": "https://docs.poli.page",
  "bugs": { "url": "https://github.com/poli-page/nextjs/issues" }
}
